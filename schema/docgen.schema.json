{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "include": {
      "default": ["src/**/*.ts", "src/**/*.tsx"],
      "type": "array",
      "items": { "type": "string" }
    },
    "exclude": {
      "default": [
        "**/*.d.ts",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/coverage/**"
      ],
      "type": "array",
      "items": { "type": "string" }
    },
    "tests": {
      "default": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**"
      ],
      "type": "array",
      "items": { "type": "string" }
    },
    "workspace": {
      "type": "object",
      "properties": {
        "projects": {
          "default": ["tsconfig.json"],
          "minItems": 1,
          "type": "array",
          "items": { "type": "string" }
        },
        "lockfile": {
          "default": "shared",
          "type": "string",
          "enum": ["shared", "perProject"]
        },
        "projectConcurrency": {
          "default": 1,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["projects", "lockfile", "projectConcurrency"],
      "additionalProperties": false
    },
    "symbols": {
      "type": "object",
      "properties": {
        "kinds": {
          "default": [
            "function",
            "arrow",
            "method",
            "accessor",
            "class",
            "interface",
            "typeAlias",
            "enum"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "function",
              "arrow",
              "method",
              "accessor",
              "class",
              "interface",
              "typeAlias",
              "enum",
              "variable"
            ]
          }
        },
        "exportedOnly": { "default": true, "type": "boolean" },
        "publicSurface": {
          "default": "syntacticExports",
          "type": "string",
          "enum": ["syntacticExports", "entryPoints"]
        },
        "entryPoints": {
          "default": ["src/index.ts"],
          "type": "array",
          "items": { "type": "string" }
        },
        "visibility": {
          "default": ["public"],
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["public", "protected", "private", "package"]
          }
        },
        "minBodyLines": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ignorePragmas": {
          "default": ["@docgen-ignore", "@internal"],
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "kinds",
        "exportedOnly",
        "publicSurface",
        "entryPoints",
        "visibility",
        "minBodyLines",
        "ignorePragmas"
      ],
      "additionalProperties": false
    },
    "docs": {
      "type": "object",
      "properties": {
        "style": { "default": "jsdoc", "type": "string", "const": "jsdoc" },
        "granularity": {
          "default": "standard",
          "type": "string",
          "enum": ["minimal", "standard", "detailed"]
        },
        "emitTypes": { "default": false, "type": "boolean" },
        "leadingComments": {
          "type": "object",
          "properties": {
            "includeInContext": { "default": true, "type": "boolean" },
            "onGenerate": {
              "default": "preserve",
              "type": "string",
              "enum": ["preserve", "replace"]
            }
          },
          "required": ["includeInContext", "onGenerate"],
          "additionalProperties": false
        },
        "tags": {
          "type": "object",
          "properties": {
            "params": { "default": true, "type": "boolean" },
            "returns": { "default": true, "type": "boolean" },
            "throws": { "default": true, "type": "boolean" },
            "example": { "default": false, "type": "boolean" }
          },
          "required": ["params", "returns", "throws", "example"],
          "additionalProperties": false
        },
        "preserveTags": {
          "default": [
            "deprecated",
            "example",
            "see",
            "internal",
            "since",
            "template"
          ],
          "type": "array",
          "items": { "type": "string" }
        },
        "lineWidth": {
          "default": 80,
          "type": "integer",
          "minimum": 40,
          "maximum": 9007199254740991
        },
        "maxLineWidth": {
          "default": 90,
          "type": "integer",
          "minimum": 40,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "style",
        "granularity",
        "emitTypes",
        "leadingComments",
        "tags",
        "preserveTags",
        "lineWidth",
        "maxLineWidth"
      ],
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "properties": {
        "reportMissing": { "default": false, "type": "boolean" },
        "reportOrphaned": { "default": true, "type": "boolean" }
      },
      "required": ["reportMissing", "reportOrphaned"],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "budgetTokens": {
          "default": 2000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sources": {
          "type": "object",
          "properties": {
            "testNames": { "default": true, "type": "boolean" },
            "ownBody": { "default": true, "type": "boolean" },
            "callSites": { "default": true, "type": "boolean" },
            "calleeSummaries": { "default": true, "type": "boolean" },
            "referencedTypes": { "default": true, "type": "boolean" },
            "gitSubject": { "default": true, "type": "boolean" },
            "calleeBodies": { "default": false, "type": "boolean" }
          },
          "required": [
            "testNames",
            "ownBody",
            "callSites",
            "calleeSummaries",
            "referencedTypes",
            "gitSubject",
            "calleeBodies"
          ],
          "additionalProperties": false
        },
        "callSites": {
          "type": "object",
          "properties": {
            "max": {
              "default": 5,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lines": {
              "default": 2,
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "sampling": {
              "default": "moduleDiversity",
              "type": "string",
              "enum": ["moduleDiversity", "first"]
            }
          },
          "required": ["max", "lines", "sampling"],
          "additionalProperties": false
        },
        "bodyMaxLines": {
          "default": 120,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "shared": {
          "type": "object",
          "properties": {
            "enabled": { "default": true, "type": "boolean" },
            "budgetTokens": {
              "default": 1200,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "minSymbols": {
              "default": 2,
              "type": "integer",
              "minimum": 2,
              "maximum": 9007199254740991
            }
          },
          "required": ["enabled", "budgetTokens", "minSymbols"],
          "additionalProperties": false
        },
        "git": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "default": 2000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["timeoutMs"],
          "additionalProperties": false
        }
      },
      "required": [
        "budgetTokens",
        "sources",
        "callSites",
        "bodyMaxLines",
        "shared",
        "git"
      ],
      "additionalProperties": false
    },
    "generate": {
      "type": "object",
      "properties": {
        "provider": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "anthropic" },
                "apiKeyEnv": {
                  "default": "ANTHROPIC_API_KEY",
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": { "type": "string", "minLength": 1 },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "apiKeyEnv", "maxOutputTokens"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "openai" },
                "apiKeyEnv": {
                  "default": "OPENAI_API_KEY",
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "default": "https://api.openai.com/v1",
                  "type": "string",
                  "minLength": 1
                },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "apiKeyEnv", "baseUrl", "maxOutputTokens"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "google" },
                "apiKeyEnv": {
                  "default": "GEMINI_API_KEY",
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "default": "https://generativelanguage.googleapis.com/v1beta",
                  "type": "string",
                  "minLength": 1
                },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "apiKeyEnv", "baseUrl", "maxOutputTokens"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "openai-compatible" },
                "baseUrl": { "type": "string", "minLength": 1 },
                "apiKeyEnv": { "type": "string", "minLength": 1 },
                "contextWindowTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "timeoutMs": {
                  "default": 120000,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "baseUrl", "maxOutputTokens", "timeoutMs"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "cli" },
                "tool": {
                  "type": "string",
                  "enum": ["claude", "codex", "gemini", "opencode", "pi"]
                },
                "command": { "type": "string", "minLength": 1 },
                "args": {
                  "default": [],
                  "type": "array",
                  "items": { "type": "string" }
                },
                "timeoutMs": {
                  "default": 120000,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "tool", "args", "timeoutMs"],
              "additionalProperties": false
            }
          ]
        },
        "model": { "default": "claude-sonnet-5", "type": "string" },
        "concurrency": {
          "default": 8,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxSymbolsPerRun": {
          "default": 500,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["provider", "model", "concurrency", "maxSymbolsPerRun"],
      "additionalProperties": false
    },
    "judge": {
      "type": "object",
      "properties": {
        "enabled": { "default": true, "type": "boolean" },
        "provider": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "anthropic" },
                "apiKeyEnv": {
                  "default": "ANTHROPIC_API_KEY",
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": { "type": "string", "minLength": 1 },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "apiKeyEnv", "maxOutputTokens"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "openai" },
                "apiKeyEnv": {
                  "default": "OPENAI_API_KEY",
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "default": "https://api.openai.com/v1",
                  "type": "string",
                  "minLength": 1
                },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "apiKeyEnv", "baseUrl", "maxOutputTokens"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "google" },
                "apiKeyEnv": {
                  "default": "GEMINI_API_KEY",
                  "type": "string",
                  "minLength": 1
                },
                "baseUrl": {
                  "default": "https://generativelanguage.googleapis.com/v1beta",
                  "type": "string",
                  "minLength": 1
                },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "apiKeyEnv", "baseUrl", "maxOutputTokens"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "openai-compatible" },
                "baseUrl": { "type": "string", "minLength": 1 },
                "apiKeyEnv": { "type": "string", "minLength": 1 },
                "contextWindowTokens": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "maxOutputTokens": {
                  "default": 1200,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "timeoutMs": {
                  "default": 120000,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "baseUrl", "maxOutputTokens", "timeoutMs"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "const": "cli" },
                "tool": {
                  "type": "string",
                  "enum": ["claude", "codex", "gemini", "opencode", "pi"]
                },
                "command": { "type": "string", "minLength": 1 },
                "args": {
                  "default": [],
                  "type": "array",
                  "items": { "type": "string" }
                },
                "timeoutMs": {
                  "default": 120000,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["kind", "tool", "args", "timeoutMs"],
              "additionalProperties": false
            }
          ]
        },
        "model": { "default": "claude-haiku-4-5-20251001", "type": "string" },
        "strictLeaves": { "default": true, "type": "boolean" }
      },
      "required": ["enabled", "model", "strictLeaves"],
      "additionalProperties": false
    }
  },
  "required": [
    "include",
    "exclude",
    "tests",
    "workspace",
    "symbols",
    "docs",
    "check",
    "context",
    "generate",
    "judge"
  ],
  "additionalProperties": false,
  "$id": "https://unpkg.com/docgen-drift@1/schema/docgen.schema.json",
  "title": "docgen configuration",
  "description": "Configuration for symbol-level TypeScript and JavaScript documentation drift detection."
}

{
  "name": "docgen-drift",
  "version": "0.1.0",
  "description": "Symbol-level documentation drift detection for TypeScript and JavaScript",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "docgen": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests --maxWorkers=2 --testTimeout=30000",
    "test:watch": "vitest --maxWorkers=2 --testTimeout=30000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
